---
// Contenido de la home, compartido por /  (ES) y /en/ (EN).
// Para añadir una sección nueva (p. ej. Experiencia), crea el componente
// y colócalo aquí en el orden deseado; el layout no necesita cambios.
import Hero from './Hero.astro';
import About from './About.astro';
import Projects from './Projects.astro';
import Contact from './Contact.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Hero lang={lang} />
<About lang={lang} />
<Projects lang={lang} />
<Contact lang={lang} />
