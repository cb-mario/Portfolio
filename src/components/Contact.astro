---
import Icon, { type IconName } from './Icon.astro';
import LinkButton from './LinkButton.astro';
import { isPlaceholder, site } from '../data/site';
import { assetUrl, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);

const channels: { label: string; value: string; href: string; icon: IconName; external?: boolean }[] = [
  { label: 'Email', value: site.email, href: `mailto:${site.email}`, icon: 'mail' },
  { label: 'LinkedIn', value: site.linkedin, href: site.linkedin, icon: 'linkedin', external: true },
  {
    label: 'GitHub',
    value: site.github.replace(/^https?:\/\//, ''),
    href: site.github,
    icon: 'github',
    external: true,
  },
];
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container">
    <h2 id="contact-title" class="section-title">{t('contact.title')}</h2>
    <p class="intro">{t('contact.body')}</p>

    <ul class="channels">
      {
        channels.map((c) => (
          <li>
            <Icon name={c.icon} />
            <span class="label">{c.label}</span>
            {isPlaceholder(c.value) ? (
              <span class="placeholder" title="TODO: completar en src/data/site.ts">
                {c.value}
              </span>
            ) : (
              <a
                href={c.href}
                target={c.external ? '_blank' : undefined}
                rel={c.external ? 'noopener noreferrer' : undefined}
              >
                {c.value}
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <LinkButton href={assetUrl(site.cvFile)} label={t('cta.cv')} icon="download" variant="primary" download />
  </div>
</section>

<style>
  .intro {
    max-width: 50ch;
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .channels {
    list-style: none;
    padding: 0;
    margin-block: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .channels li {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    column-gap: var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .channels svg {
    grid-row: span 2;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-accent);
  }

  .label {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .channels a,
  .placeholder {
    overflow-wrap: anywhere;
    font-weight: 500;
  }

  .placeholder {
    color: var(--color-text-muted);
    border-bottom: 1px dashed var(--color-accent);
    justify-self: start;
  }

  @media (min-width: 40rem) {
    .channels li {
      grid-template-columns: auto 8rem 1fr;
    }

    .channels svg {
      grid-row: auto;
    }
  }
</style>
