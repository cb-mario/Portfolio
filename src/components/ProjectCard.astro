---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Project } from '../data/projects';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const imageHref = project.demo ?? project.repo;
---

<article class="card">
  {
    project.image && imageHref && (
      <a class="preview" href={imageHref} target="_blank" rel="noopener noreferrer" tabindex="-1">
        <Image src={project.image.src} alt={project.image.alt[lang]} widths={[400, 800]} sizes="(min-width: 48rem) 400px, 100vw" />
        <span class="preview-label" aria-hidden="true">
          {t('projects.visit')}
          <Icon name="external" />
        </span>
      </a>
    )
  }
  <h3>{project.title}</h3>
  <p class="description">{project.description[lang]}</p>

  {
    project.tags.length > 0 && (
      <ul class="tags">
        {project.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    )
  }

  {
    (project.repo || project.demo) && (
      <div class="links">
        {project.repo && (
          <a href={project.repo} target="_blank" rel="noopener noreferrer">
            <Icon name="github" />
            {t('projects.code')}
            <span class="visually-hidden">— {project.title}</span>
          </a>
        )}
        {project.demo && (
          <a href={project.demo} target="_blank" rel="noopener noreferrer">
            <Icon name="external" />
            {t('projects.demo')}
            <span class="visually-hidden">— {project.title}</span>
          </a>
        )}
      </div>
    )
  }
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-8);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    transition: border-color var(--transition), transform var(--transition);
  }

  .card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .preview {
    position: relative;
    display: block;
    overflow: hidden;
    margin: calc(var(--space-8) * -1) calc(var(--space-8) * -1) var(--space-2);
    border-bottom: 1px solid var(--color-border);
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  .preview :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1200 / 630;
    object-fit: cover;
    transition: transform 400ms ease;
  }

  .preview-label {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 600;
    opacity: 0;
    transform: translateY(0.5rem);
    transition: opacity 250ms ease, transform 250ms ease;
  }

  .preview-label :global(svg) {
    width: 0.875rem;
    height: 0.875rem;
  }

  .preview:hover :global(img) {
    transform: scale(1.05);
  }

  .preview:hover .preview-label {
    opacity: 1;
    transform: translateY(0);
  }

  h3 {
    font-size: var(--text-xl);
  }

  .description {
    color: var(--color-text-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
    font-size: var(--text-sm);
  }

  .tags li {
    padding: var(--space-1) var(--space-3);
    background: var(--color-accent-soft);
    color: var(--color-text);
    border-radius: var(--radius-full);
  }

  .links {
    display: flex;
    gap: var(--space-6);
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
  }

  .links :global(svg) {
    width: 1rem;
    height: 1rem;
  }
</style>
